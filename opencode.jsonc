{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-5-20250929",
      "prompt": "{file:./llm/prompts/plan-writer.txt}",
      "tools": {
        "bash": false,
        "beads": true,
        "edit": false,
        "git": false,
        "write": false
      }
    },
    "build": {
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-5-20250929",
      "prompt": "{file:./llm/prompts/code-writer.txt}",
      "tools": {
        "bash": true,
        "beads": true,
        "edit": true,
        "git": true,
        "write": true
      }
    },
    "codereviewer": {
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5-20251001",
      "prompt": "{file:./llm/prompts/code-reviewer.txt}",
      "tools": {
        "bash": false,
        "beads": false,
        "edit": false,
        "git": false,
        "write": false
      }
    }
  },
  "mcp": {
    "beads": {
      "command": ["uv", "run", "beads-mcp"],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    // "edit": "ask",
    // "bash": "ask"
  }
}
